# Backend base URL for the pgDeskOwner app (no /api/v1 suffix)
# localhost is automatically translated for emulators:
#   - Android emulator -> http://10.0.2.2:8080
#   - iOS simulator    -> http://127.0.0.1:8080
# For a physical device, replace this with your host machine's LAN IP, e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.x:8080
#
# Quick auto-detect (run from project root):
#   node scripts/update-api-url.js
EXPO_PUBLIC_API_URL=http://localhost:8080
